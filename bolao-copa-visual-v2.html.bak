     1|<!DOCTYPE html>
     2|<html lang="pt-BR">
     3|<head>
     4|    <meta charset="UTF-8">
     5|    <meta name="viewport" content="width=device-width, initial-scale=1.0">
     6|    <title>Bolão Copa do Mundo 2026 🏆 - Planeta Energia</title>
     7|    <meta name="description" content="Participe do Bolão Virtual da Copa do Mundo 2026 promovido pela Planeta Energia. Faça seus palpites, acumule pontos e ganhe prêmios!">
     8|    <meta name="keywords" content="bolão, copa do mundo, 2026, palpites, futebol, Planeta Energia">
     9|    <meta property="og:title" content="Bolão Copa do Mundo 2026 🏆 - Planeta Energia">
    10|    <meta property="og:description" content="Faça seus palpites nos jogos do Brasil e concorra a R$ 500 em vale-compras!">
    11|    <meta property="og:type" content="website">
    12|    <meta property="og:url" content="https://maylon-roge.github.io/projetos-mplan/bolao-copa-visual-v2.html">
    13|    <meta property="og:image" content="https://maylon-roge.github.io/projetos-mplan/assets/bolao-og.jpg">
